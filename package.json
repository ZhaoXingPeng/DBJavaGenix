{
  "name": "dbjavagenix-mcp-server",
  "version": "0.1.1",
  "description": "Node.js stdio wrapper for the DBJavaGenix Python MCP server. For containerized usage prefer the Docker image.",
  "main": "index.js",
  "bin": {
    "dbjavagenix-mcp": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "verify:package": "node scripts/verify_npm_package.js"
  },
  "files": [
    "index.js",
    "src/dbjavagenix/**/*.py",
    "src/dbjavagenix/**/*.mustache",
    "src/dbjavagenix/config/*.yaml",
    "pyproject.toml",
    "requirements.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhaoXingPeng/DBJavaGenix.git"
  },
  "bugs": {
    "url": "https://github.com/ZhaoXingPeng/DBJavaGenix/issues"
  },
  "homepage": "https://github.com/ZhaoXingPeng/DBJavaGenix#readme",
  "keywords": [
    "mcp",
    "java",
    "code-generation",
    "database",
    "mysql",
    "spring-boot"
  ],
  "author": "ZXP <2638265504@qq.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}
